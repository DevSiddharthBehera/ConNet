# Copy this file to `.env` and fill in your credentials. Do NOT commit your `.env` file.

# Supabase project URL (from your Supabase project settings)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase service role key (server-side!). Use the service_role key for server uploads.
# Keep this secret and never expose it in client-side code.
SUPABASE_KEY=your-service-role-key

# Optional: bucket name to use for uploads (default: avatars)
SUPABASE_BUCKET=avatars

# Other app envs (examples)
PORT=4000
MONGO_URI=mongodb://localhost:27017/connet

# Notes:
# - After creating Backend/.env, restart your backend server so the process picks up these values.
# - Install the Supabase client on the backend: `npm install @supabase/supabase-js`
